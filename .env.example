# Só necessárias se você trocar 'openai_provider'/'claude_provider' em
# config/models.json pra 'openai-api'/'claude-api' — com os provedores
# padrão (codex-local/claude-code-local) nenhuma das duas é lida, e a
# rodada usa a assinatura ChatGPT/Codex e Claude Code já logada na máquina.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Plano free da NVIDIA NIM (integrate.api.nvidia.com) — sem custo por token,
# só limite de 40 req/min. Usada pela Solenne, 3º parecer independente do
# conselho. Se ausente, a rodada segue sem ela (não é obrigatória).
NVIDIA_API_KEY=

# Opcional. O padrão já aponta para o Ollama local. DeepSeek e Kimi são
# detectados pela lista de modelos do runtime; nenhuma credencial é lida
# pelo Quorum. Para modelos cloud, autentique diretamente com `ollama signin`.
OLLAMA_HOST=http://127.0.0.1:11434

# Opcional. OpenRouter (openrouter.ai) — agregador cloud com modelos pagos e
# gratuitos (sufixo ":free" na lista de /v1/models). Sem a chave, o
# especialista correspondente volta 'failed'/'openrouter_key_missing' e a
# rodada segue sem ele.
OPENROUTER_API_KEY=

# Opcional. OmniRoute (omniroute.online, pacote npm "omniroute") — gateway
# LOCAL self-hosted (npm install -g omniroute && omniroute), zero-config, sem
# chave obrigatória. Só precisa mudar se você rodar o gateway em outra
# porta/host que não http://localhost:20128.
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=

# Antigravity/Gemini usa as credenciais guardadas pelo próprio `agy` no
# keyring do sistema. O Quorum nunca lê nem armazena esse token.
