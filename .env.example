# Só necessárias se você trocar 'openai_provider'/'claude_provider' em
# config/models.json pra 'openai-api'/'claude-api' — com os provedores
# padrão (codex-local/claude-code-local) nenhuma das duas é lida, e a
# rodada usa a assinatura ChatGPT/Codex e Claude Code já logada na máquina.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Plano free da NVIDIA NIM (integrate.api.nvidia.com) — sem custo por token,
# só limite de 40 req/min. Usada pela Solenne, 3º parecer independente do
# conselho. Se ausente, a rodada segue sem ela (não é obrigatória).
NVIDIA_API_KEY=
